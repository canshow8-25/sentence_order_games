<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>English Learning Games</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, "Meiryo", sans-serif;
      background: linear-gradient(135deg, #eef4ff, #f8f9fc);
      color: #26364a;
      min-height: 100vh;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: 55px 20px 40px;
    }

    /* ===== Header ===== */

    .header {
      text-align: center;
      margin-bottom: 45px;
    }

    .header .small-title {
      font-size: 14px;
      font-weight: bold;
      letter-spacing: 3px;
      color: #667eea;
      margin-bottom: 10px;
    }

    .header h1 {
      font-size: 42px;
      margin: 0;
      letter-spacing: 1px;
    }

    .header p {
      margin: 12px 0 0;
      color: #718096;
      font-size: 16px;
    }

    /* ===== Game Cards ===== */

    .games {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .game-card {
      position: relative;
      background: white;
      border-radius: 20px;
      padding: 30px 20px 28px;
      text-align: center;
      text-decoration: none;
      color: #26364a;

      box-shadow:
        0 8px 25px rgba(40, 60, 100, 0.08);

      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }

    .game-card:hover {
      transform: translateY(-7px);

      box-shadow:
        0 14px 30px rgba(40, 60, 100, 0.14);
    }

    .icon {
      width: 75px;
      height: 75px;
      margin: 0 auto 18px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 50%;
      background: #eef2ff;

      font-size: 36px;
    }

    .game-card h2 {
      margin: 0 0 8px;
      font-size: 24px;
    }

    .game-card .description {
      margin: 0 0 20px;
      color: #718096;
      font-size: 14px;
      line-height: 1.5;
    }

    .start-button {
      display: inline-block;

      padding: 9px 22px;

      border-radius: 30px;

      background: #667eea;
      color: white;

      font-size: 13px;
      font-weight: bold;

      letter-spacing: 0.5px;
    }

    /* ===== Grade Colors ===== */

    .grade1 .icon {
      background: #edf7ed;
    }

    .grade1 .start-button {
      background: #48a868;
    }

    .grade2 .icon {
      background: #eef2ff;
    }

    .grade2 .start-button {
      background: #667eea;
    }

    .grade3 .icon {
      background: #fff5e8;
    }

    .grade3 .start-button {
      background: #e89a3d;
    }

    /* ===== Footer ===== */

    .footer {
      text-align: center;
      margin-top: 50px;
      color: #9aa5b1;
      font-size: 12px;
      letter-spacing: 0.5px;
    }

    /* ===== Smartphone ===== */

    @media (max-width: 650px) {

      .container {
        padding: 40px 18px 30px;
      }

      .header {
        margin-bottom: 32px;
      }

      .header h1 {
        font-size: 32px;
      }

      .header p {
        font-size: 14px;
      }

      .games {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .game-card {
        display: grid;
        grid-template-columns: 75px 1fr;
        grid-template-rows: auto auto;
        column-gap: 18px;

        text-align: left;
        padding: 20px;
      }

      .icon {
        grid-row: 1 / 3;
        margin: 0;
      }

      .game-card h2 {
        align-self: end;
        margin-bottom: 3px;
      }

      .game-card .description {
        align-self: start;
        margin-bottom: 0;
      }

      .start-button {
        display: none;
      }
    }

  </style>
</head>


<body>

  <div class="container">

    <!-- Header -->

    <div class="header">

      <div class="small-title">
        ENGLISH LEARNING
      </div>

      <h1>🎮 English Games</h1>

      <p>
        Choose a game and challenge yourself!
      </p>

    </div>


    <!-- Games -->

    <div class="games">


      <!-- Grade 1 -->

      <a class="game-card grade1" href="grade1.html">

        <div class="icon">
          📝
        </div>

        <div>
          <h2>Grade 1</h2>

          <p class="description">
            英文を正しい順番に<br>
            並べ替えよう！
          </p>

          <span class="start-button">
            START →
          </span>
        </div>

      </a>


      <!-- Grade 2 -->

      <a class="game-card grade2" href="grade2.html">

        <div class="icon">
          🚀
        </div>

        <div>
          <h2>Grade 2</h2>

          <p class="description">
            英文を正しい順番に<br>
            並べ替えよう！
          </p>

          <span class="start-button">
            START →
          </span>
        </div>

      </a>


      <!-- Grade 3 -->

      <a class="game-card grade3" href="grade3.html">

        <div class="icon">
          🏆
        </div>

        <div>
          <h2>Grade 3</h2>

          <p class="description">
            英文を正しい順番に<br>
            並べ替えよう！
          </p>

          <span class="start-button">
            START →
          </span>
        </div>

      </a>


    </div>


    <!-- Footer -->

    <div class="footer">
      English Learning Games
    </div>

  </div>

</body>
</html>
